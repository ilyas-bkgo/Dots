#!/usr/bin/env bash
set -euo pipefail

portal_bus="org.freedesktop.portal.Desktop"
portal_bin="/usr/libexec/xdg-desktop-portal"
log_dir="${XDG_STATE_HOME:-$HOME/.local/state}/desktop-portal"

if busctl --user --quiet status "$portal_bus" >/dev/null 2>&1; then
    exit 0
fi

mkdir -p "$log_dir"
setsid "$portal_bin" </dev/null >>"$log_dir/portal.log" 2>&1 &

for _ in {1..40}; do
    if busctl --user --quiet status "$portal_bus" >/dev/null 2>&1; then
        exit 0
    fi
    sleep 0.25
done

printf 'xdg-desktop-portal did not acquire %s; see %s/portal.log\n' "$portal_bus" "$log_dir" >&2
exit 1
