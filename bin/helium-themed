#!/usr/bin/env bash
set -euo pipefail
helium_bin="$(command -v helium || true)"
if [[ -z "$helium_bin" && -x /opt/helium/helium ]]; then helium_bin=/opt/helium/helium; fi
if [[ -z "$helium_bin" ]]; then echo "Helium executable not found" >&2; exit 127; fi
exec "$helium_bin" --load-extension="$HOME/.config/net.imput.helium/theme-switcher" "$@"
