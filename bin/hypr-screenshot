#!/usr/bin/env bash
set -euo pipefail

mode=${1:-full}
out_dir="$HOME/Pictures/Screenshots"
mkdir -p "$out_dir"
file="$out_dir/Screenshot-$(date '+%Y-%m-%d_%H-%M-%S_%N').png"

case "$mode" in
    full)
        grim "$file"
        ;;
    area)
        geometry=$(slurp) || exit 0
        [[ -n "$geometry" ]] || exit 0
        grim -g "$geometry" "$file"
        ;;
    *)
        echo "Usage: $0 [full|area]" >&2
        exit 2
        ;;
esac

wl-copy --type image/png < "$file"
hyprctl notify 5 2800 'rgb(a7c080)' 'Screenshot saved and copied to clipboard'
