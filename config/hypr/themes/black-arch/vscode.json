  "editor.tokenColorCustomizations": {
    "comments": "#989898",
    "strings": "#8e8e8e",
    "keywords": "#747474",
    "numbers": "#b9b9b9",
    "functions": "#989898",
    "types": "#b9b9b9",
    "variables": "#ffffff",
    "textMateRules": [
      {
        "scope": [
          "comment",
          "punctuation.definition.comment"
        ],
        "settings": {
          "foreground": "#989898"
        }
      },
      {
        "scope": [
          "string",
          "constant.other.symbol"
        ],
        "settings": {
          "foreground": "#8e8e8e"
        }
      },
      {
        "scope": [
          "keyword",
          "storage",
          "keyword.operator"
        ],
        "settings": {
          "foreground": "#747474"
        }
      },
      {
        "scope": [
          "entity.name.function",
          "support.function"
        ],
        "settings": {
          "foreground": "#989898"
        }
      },
      {
        "scope": [
          "entity.name.type",
          "support.type",
          "entity.name.class"
        ],
        "settings": {
          "foreground": "#b9b9b9"
        }
      },
      {
        "scope": [
          "constant.numeric",
          "constant.language"
        ],
        "settings": {
          "foreground": "#b9b9b9"
        }
      }
    ]
  }
