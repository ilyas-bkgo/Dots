  "editor.tokenColorCustomizations": {
    "comments": "#9aa1b7",
    "strings": "#a6e3a1",
    "keywords": "#cba6f7",
    "numbers": "#f9e2af",
    "functions": "#89b4fa",
    "types": "#94e2d5",
    "variables": "#cdd6f4",
    "textMateRules": [
      {
        "scope": [
          "comment",
          "punctuation.definition.comment"
        ],
        "settings": {
          "foreground": "#9aa1b7"
        }
      },
      {
        "scope": [
          "string",
          "constant.other.symbol"
        ],
        "settings": {
          "foreground": "#a6e3a1"
        }
      },
      {
        "scope": [
          "keyword",
          "storage",
          "keyword.operator"
        ],
        "settings": {
          "foreground": "#cba6f7"
        }
      },
      {
        "scope": [
          "entity.name.function",
          "support.function"
        ],
        "settings": {
          "foreground": "#89b4fa"
        }
      },
      {
        "scope": [
          "entity.name.type",
          "support.type",
          "entity.name.class"
        ],
        "settings": {
          "foreground": "#94e2d5"
        }
      },
      {
        "scope": [
          "constant.numeric",
          "constant.language"
        ],
        "settings": {
          "foreground": "#f9e2af"
        }
      }
    ]
  }
}
