  "editor.tokenColorCustomizations": {
    "comments": "#aaa0ae",
    "strings": "#8eaa83",
    "keywords": "#aa87b7",
    "numbers": "#e2c177",
    "functions": "#d0a753",
    "types": "#8196c2",
    "variables": "#f0e9dc",
    "textMateRules": [
      {
        "scope": [
          "comment",
          "punctuation.definition.comment"
        ],
        "settings": {
          "foreground": "#aaa0ae"
        }
      },
      {
        "scope": [
          "string",
          "constant.other.symbol"
        ],
        "settings": {
          "foreground": "#8eaa83"
        }
      },
      {
        "scope": [
          "keyword",
          "storage",
          "keyword.operator"
        ],
        "settings": {
          "foreground": "#aa87b7"
        }
      },
      {
        "scope": [
          "entity.name.function",
          "support.function"
        ],
        "settings": {
          "foreground": "#d0a753"
        }
      },
      {
        "scope": [
          "entity.name.type",
          "support.type",
          "entity.name.class"
        ],
        "settings": {
          "foreground": "#8196c2"
        }
      },
      {
        "scope": [
          "constant.numeric",
          "constant.language"
        ],
        "settings": {
          "foreground": "#e2c177"
        }
      }
    ]
  }
