  "editor.tokenColorCustomizations": {
    "comments": "#928374",
    "strings": "#b8bb26",
    "keywords": "#d3869b",
    "numbers": "#fabd2f",
    "functions": "#d79921",
    "types": "#83a598",
    "variables": "#ebdbb2",
    "textMateRules": [
      {
        "scope": [
          "comment",
          "punctuation.definition.comment"
        ],
        "settings": {
          "foreground": "#928374"
        }
      },
      {
        "scope": [
          "string",
          "constant.other.symbol"
        ],
        "settings": {
          "foreground": "#b8bb26"
        }
      },
      {
        "scope": [
          "keyword",
          "storage",
          "keyword.operator"
        ],
        "settings": {
          "foreground": "#d3869b"
        }
      },
      {
        "scope": [
          "entity.name.function",
          "support.function"
        ],
        "settings": {
          "foreground": "#d79921"
        }
      },
      {
        "scope": [
          "entity.name.type",
          "support.type",
          "entity.name.class"
        ],
        "settings": {
          "foreground": "#83a598"
        }
      },
      {
        "scope": [
          "constant.numeric",
          "constant.language"
        ],
        "settings": {
          "foreground": "#fabd2f"
        }
      }
    ]
  }
}
