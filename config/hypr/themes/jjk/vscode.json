  "editor.tokenColorCustomizations": {
    "comments": "#9d9ab8",
    "strings": "#8acb88",
    "keywords": "#bd91ff",
    "numbers": "#e4c16f",
    "functions": "#b58cff",
    "types": "#78dce8",
    "variables": "#e7e6f5",
    "textMateRules": [
      {
        "scope": [
          "comment",
          "punctuation.definition.comment"
        ],
        "settings": {
          "foreground": "#9d9ab8"
        }
      },
      {
        "scope": [
          "string",
          "constant.other.symbol"
        ],
        "settings": {
          "foreground": "#8acb88"
        }
      },
      {
        "scope": [
          "keyword",
          "storage",
          "keyword.operator"
        ],
        "settings": {
          "foreground": "#bd91ff"
        }
      },
      {
        "scope": [
          "entity.name.function",
          "support.function"
        ],
        "settings": {
          "foreground": "#b58cff"
        }
      },
      {
        "scope": [
          "entity.name.type",
          "support.type",
          "entity.name.class"
        ],
        "settings": {
          "foreground": "#78dce8"
        }
      },
      {
        "scope": [
          "constant.numeric",
          "constant.language"
        ],
        "settings": {
          "foreground": "#e4c16f"
        }
      }
    ]
  }
