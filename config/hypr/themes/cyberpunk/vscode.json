  "editor.tokenColorCustomizations": {
    "comments": "#a5a9b8",
    "strings": "#9fe870",
    "keywords": "#c792ea",
    "numbers": "#ffd166",
    "functions": "#ff3b81",
    "types": "#00e5ff",
    "variables": "#f5e6e8",
    "textMateRules": [
      {
        "scope": [
          "comment",
          "punctuation.definition.comment"
        ],
        "settings": {
          "foreground": "#a5a9b8"
        }
      },
      {
        "scope": [
          "string",
          "constant.other.symbol"
        ],
        "settings": {
          "foreground": "#9fe870"
        }
      },
      {
        "scope": [
          "keyword",
          "storage",
          "keyword.operator"
        ],
        "settings": {
          "foreground": "#c792ea"
        }
      },
      {
        "scope": [
          "entity.name.function",
          "support.function"
        ],
        "settings": {
          "foreground": "#ff3b81"
        }
      },
      {
        "scope": [
          "entity.name.type",
          "support.type",
          "entity.name.class"
        ],
        "settings": {
          "foreground": "#00e5ff"
        }
      },
      {
        "scope": [
          "constant.numeric",
          "constant.language"
        ],
        "settings": {
          "foreground": "#ffd166"
        }
      }
    ]
  }
