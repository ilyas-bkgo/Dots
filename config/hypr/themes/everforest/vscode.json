  "editor.tokenColorCustomizations": {
    "comments": "#868d80",
    "strings": "#87c095",
    "keywords": "#d39bb6",
    "numbers": "#d9bb80",
    "functions": "#a7c080",
    "types": "#83b6af",
    "variables": "#d8caac",
    "textMateRules": [
      {
        "scope": [
          "comment",
          "punctuation.definition.comment"
        ],
        "settings": {
          "foreground": "#868d80"
        }
      },
      {
        "scope": [
          "string",
          "constant.other.symbol"
        ],
        "settings": {
          "foreground": "#87c095"
        }
      },
      {
        "scope": [
          "keyword",
          "storage",
          "keyword.operator"
        ],
        "settings": {
          "foreground": "#d39bb6"
        }
      },
      {
        "scope": [
          "entity.name.function",
          "support.function"
        ],
        "settings": {
          "foreground": "#a7c080"
        }
      },
      {
        "scope": [
          "entity.name.type",
          "support.type",
          "entity.name.class"
        ],
        "settings": {
          "foreground": "#83b6af"
        }
      },
      {
        "scope": [
          "constant.numeric",
          "constant.language"
        ],
        "settings": {
          "foreground": "#d9bb80"
        }
      }
    ]
  }
}
